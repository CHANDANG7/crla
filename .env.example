# ── ZECRO-RL Environment Configuration ────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://zecro:zecro_pass@localhost:5432/zecro_rl
DATABASE_SYNC_URL=postgresql://zecro:zecro_pass@localhost:5432/zecro_rl

# ── Delta Exchange ─────────────────────────────────────────────────────────────
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_BASE_URL=https://api.india.delta.exchange

# ── Groq ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048

# ── Embeddings (for RAG) ────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: OpenAI for higher quality embeddings
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# ── Paper Trading ──────────────────────────────────────────────────────────────
INITIAL_CAPITAL_INR=10000000
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS_INR=75000
MAX_PORTFOLIO_DD=0.10
MAX_OPEN_POSITIONS=3
PAPER_TRADING_MODE=true

# ── RL Training ────────────────────────────────────────────────────────────────
RL_ALGORITHM=PPO
RL_LEARNING_RATE=0.0003
RL_GAMMA=0.99
RL_CLIP_EPSILON=0.2
RL_ENTROPY_COEF=0.01
RL_N_STEPS=2048
RL_BATCH_SIZE=64
RL_N_EPOCHS=10
RL_MODELS_DIR=./models/policies

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── API ─────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_in_production_use_a_long_random_string
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Redis (optional: for task queuing) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/zecro_rl.log
